PORT=3001
NODE_ENV=development
CUSTOMER_ORIGIN=http://localhost:5173
CUSTOMER_APP_ORIGIN=http://localhost:5173
# Web application OAuth client ID; public configuration is supplied to the PWA.
GOOGLE_CLIENT_ID=
# Optional server-only address lookup. Never expose this key through VITE_*.
GOOGLE_GEOCODING_API_KEY=
# Comma-separated approved service-area PIN prefixes. Empty accepts enquiries
# subject to executive coverage confirmation; configure before public launch.
SERVICE_PIN_PREFIXES=
# Optional JSON array [{"id":"09:00-12:00","label":"Morning · 9 AM to 12 PM"}].
# Omit to use the API's default preferred windows (not guaranteed availability).
# Required in Phase 3; never commit actual credentials.
DATABASE_URL=postgresql://neondb_owner:npg_rjEbZw1YJC4t@ep-royal-cherry-b4bodlst-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
OTP_PROVIDER=development
# One-time bootstrap only; do not commit real values.
ADMIN_USERNAME=Alex
ADMIN_PASSWORD=
ADMIN_NAME=

# Technician private uploads (server-only S3-compatible credentials).
# Use a private bucket with CORS permitting the operations app origin for PUT.
AWS_ENDPOINT_URL_S3=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TECHNICIAN_STORAGE_BUCKET=uploads
# Required in production for encrypted technician authenticator secrets.
# Set a strong random secret; preserve it across restarts and deployments.
TECHNICIAN_MFA_ENCRYPTION_KEY=
