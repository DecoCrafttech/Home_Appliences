NODE_ENV=production
CUSTOMER_ORIGIN=https://fixbeez.in
CUSTOMER_APP_ORIGIN=https://fixbeez.in
ADMIN_ORIGIN=https://admin.fixbeez.in
TECHNICIAN_ORIGIN=https://technician.fixbeez.in
# Use the trusted reverse-proxy hop count confirmed by Hostinger; default is 0.
TRUST_PROXY_HOPS=0
# Leave PORT to Hostinger's runtime configuration.
DATABASE_URL=
GOOGLE_CLIENT_ID=
TECHNICIAN_MFA_ENCRYPTION_KEY=
# Preserve existing MFA encryption keys when moving an existing database.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
TECHNICIAN_STORAGE_BUCKET=uploads
# Optional: configure all three together for notifications.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:operations@fixbeez.in
